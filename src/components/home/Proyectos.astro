---
import Pill from '../Pill.astro';
import ProyectoImagen from '../ProyectoImagen.astro';
import NucleoCodigo from '../visuals/NucleoCodigo.astro';
import { proyectos } from '../../data/proyectos';
---

<section id="proyectos" class="scroll-mt-4 bg-surface">
  <div class="container-page flex flex-col gap-9 pt-16 pb-14 lg:pt-[72px] lg:pb-16">
    <p class="note text-mint">02 / proyectos_seleccionados</p>

    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2
        class="min-w-0 flex-1 font-display text-[clamp(36px,3.9vw,56px)] leading-[1.08] font-bold tracking-[-0.027em]"
      >
        Proyectos personales.<br />Ideas en construcción.
      </h2>
      <div class="flex flex-col gap-3 lg:w-80 lg:shrink-0">
        <p class="font-mono text-[13px] text-mint">[ 01 — 04 ]</p>
        <p class="body-copy text-sm">Cuatro proyectos personales para explorar ideas, procesos y aprendizajes.</p>
      </div>
    </div>

    <ul class="grid gap-x-6 gap-y-12 md:grid-cols-2 xl:grid-cols-4">
      {
        proyectos.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                href={p.href}
                class:list={['group flex flex-col gap-[22px]', p.href && 'cursor-pointer']}
              >
                {p.logo ? (
                  // Como en Figma: el logo ocupa todo el ancho, alineado arriba, en un espacio
                  // de 306 × 307 (así los textos de las 4 tarjetas quedan a la misma altura)
                  <div class="aspect-[306/307]">
                    <img
                      src={p.logo.src}
                      alt={p.logo.alt}
                      width={p.logo.ancho}
                      height={p.logo.alto}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        'h-auto w-full transition-transform duration-300 motion-safe:group-hover:-translate-y-1',
                        p.logo.redondeado && 'rounded-[12.75%]',
                      ]}
                    />
                  </div>
                ) : p.imagen ? (
                  <ProyectoImagen
                    imagen={p.imagen}
                    aspect="306 / 235"
                    class="transition-colors group-hover:border-mint"
                  />
                ) : (
                  <div class="aspect-[306/235] overflow-hidden rounded-xl border border-edge transition-colors group-hover:border-mint">
                    <NucleoCodigo coordenada={`${p.numero} / lógica · conexión · posibilidad`} />
                  </div>
                )}
                <div class="flex flex-col items-start gap-4">
                  <div class="flex w-full items-center justify-between text-mint">
                    <span class="font-mono text-xs">proyecto_{p.numero}</span>
                    <span
                      class="text-[22px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </div>
                  <h3
                    class:list={[
                      'font-display text-[29px] font-medium tracking-[-0.034em]',
                      p.href && 'group-hover:text-mint',
                    ]}
                  >
                    {p.titulo}
                  </h3>
                  <Pill>{p.herramientas}</Pill>
                  <p class="font-mono text-[11px] text-slate">{p.estado}</p>
                </div>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
