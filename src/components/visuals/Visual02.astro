---
/** Recurso visual del Proyecto 02 (tarjeta 416 × 320, node 124:6585): imagen 3D. */
interface Props {
  coordenada: string;
  class?: string;
}

const { coordenada, class: className } = Astro.props;
---

<div
  class:list={['canvas relative overflow-hidden rounded-xl bg-surface', className]}
  style={{ '--canvas': 416, aspectRatio: '416 / 320' }}
>
  <img
    src="/images/proyecto-02.png"
    alt="Render 3D de un anillo translúcido verde con un cubo en el centro, sobre una roca"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 size-full object-cover"
  />
  <div class="canvas-inner absolute inset-0">
    <p class="absolute top-[281.6em] left-[16.64em] font-mono whitespace-nowrap text-snow">
      <span class="text-[8em]">{coordenada}</span>
    </p>
  </div>
</div>
