---
/**
 * Recurso visual conceptual grande para la galería de un proyecto sin capturas
 * (Figma: "Proyecto personal 03 — Detalle" › "Obra conceptual", node 212:71).
 * Caja de 840 × 472 con la etiqueta "RECURSO VISUAL CONCEPTUAL" y un panel tipo editor.
 * Los colores son internos de la ilustración (regla 1 de PORTFOLIO.md).
 */
interface Props {
  /** Comentario de la primera línea, p. ej. "// proyecto_03 · TCGCheck" */
  comentario: string;
  /** Línea grande, p. ej. "idea → desarrollo → aprendizaje" */
  flujo: string;
  /** Línea azul debajo del flujo */
  bajada: string;
  /** Bloque de código del final (texto preformateado) */
  codigo: string;
  class?: string;
}

const { comentario, flujo, bajada, codigo, class: className } = Astro.props;
---

<div
  role="img"
  aria-label={`Recurso visual conceptual: ${flujo}. ${bajada}`}
  class:list={[
    'relative flex min-w-0 items-center justify-center overflow-hidden rounded-xl bg-[#161C2E] px-5 pt-16 pb-5 md:aspect-[840/472] md:p-[9.5%]',
    className,
  ]}
>
  <span
    class="absolute top-6 right-6 rounded-full bg-night/80 px-3 py-[7px] font-mono text-[11px] leading-none text-snow"
    aria-hidden="true"
  >
    RECURSO VISUAL CONCEPTUAL
  </span>
  <div
    class="flex w-full flex-col rounded-[10px] border border-[#3D666E] bg-night p-6 font-mono md:p-10"
    aria-hidden="true"
  >
    <p class="text-[clamp(13px,1.1vw,16px)] text-[#8CF0CC]">{comentario}</p>
    <p class="mt-6 text-[clamp(17px,1.75vw,25px)] text-[#E8F0F2]">{flujo}</p>
    <p class="mt-4 text-[clamp(14px,1.25vw,18px)] text-[#8CBFDB]">{bajada}</p>
    <pre class="mt-8 overflow-x-auto text-[clamp(13px,1.1vw,16px)] leading-[21px] text-[#9EADC2]">{codigo}</pre>
  </div>
</div>
