---
/** Navegación entre proyectos al final de cada caso: los otros tres (Figma node 212:122). */
import { proyectos } from '../../data/proyectos';

import type { Proyecto } from '../../data/proyectos';

interface Props {
  actual: Proyecto['numero'];
}

const { actual } = Astro.props;
const otros = proyectos.filter((p) => p.numero !== actual);
---

<section class="bg-surface">
  <div class="container-page flex flex-col gap-7 py-16">
    <div class="note flex flex-wrap justify-between gap-x-6 gap-y-1">
      <p class="text-mint">&lt;/proyecto_{actual}&gt;</p>
      <p class="text-mist">Seguí explorando el portfolio</p>
    </div>
    <ul class="grid gap-6 md:grid-cols-3">
      {
        otros.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                href={p.href}
                class:list={[
                  'group flex items-center gap-4 rounded-xl border border-edge p-5',
                  p.href && 'transition-colors hover:border-mint',
                ]}
              >
                <span class="flex size-[52px] shrink-0 items-center justify-center rounded-md bg-mint-deep font-mono text-[22px] text-mint">
                  {p.numero}
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-2">
                  <span class="font-mono text-[9px] text-slate">EXPLORAR PROYECTO</span>
                  <span class="truncate font-display text-[clamp(20px,1.6vw,23px)] tracking-[-0.031em]">{p.titulo}</span>
                </span>
                <span
                  class="text-[26px] text-mint transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
