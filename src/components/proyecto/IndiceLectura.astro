---
/**
 * Barra "LEER PROYECTO_0X ↓ · 01. Contexto · 02. Proceso · 03. Solución · 04. Aprendizajes".
 * Con `omitir` se sacan secciones (por id) y la numeración se recalcula sola.
 */
interface Props {
  numero: string;
  omitir?: string[];
  class?: string;
}

const { numero, omitir = [], class: className } = Astro.props;

const todas = [
  { nombre: 'Contexto', id: 'contexto' },
  { nombre: 'Proceso', id: 'proceso' },
  { nombre: 'Solución', id: 'solucion' },
  { nombre: 'Aprendizajes', id: 'aprendizajes' },
];

const partes = todas
  .filter((s) => !omitir.includes(s.id))
  .map((s, i) => ({ label: `${String(i + 1).padStart(2, '0')}. ${s.nombre}`, href: `#${s.id}` }));
---

<nav
  aria-label="Partes del caso"
  class:list={[
    'flex min-h-[62px] flex-wrap items-center gap-x-8 gap-y-3 border-y border-edge py-4 lg:justify-between lg:py-0',
    className,
  ]}
>
  <a href="#contexto" class="w-full font-mono text-xs text-mint hover:underline lg:w-auto">
    LEER PROYECTO_{numero} ↓
  </a>
  {
    partes.map((p) => (
      <a href={p.href} class="font-mono text-[11px] whitespace-nowrap text-mist hover:text-mint">
        {p.label}
      </a>
    ))
  }
</nav>
