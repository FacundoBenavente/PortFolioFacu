---
/**
 * TCGCheck — Detalle (diseño: Figma frame 212:44, "Proyecto personal 03").
 * Misma estructura que Sea of the Lost (02). Todavía no hay capturas: la galería
 * usa el recurso conceptual y los textos sin documentar quedan "por completar".
 */
import Layout from '../../layouts/Layout.astro';
import DetalleNav from '../../components/proyecto/DetalleNav.astro';
import Ruta from '../../components/proyecto/Ruta.astro';
import Titulo from '../../components/proyecto/Titulo.astro';
import Datos from '../../components/proyecto/Datos.astro';
import Leyenda from '../../components/proyecto/Leyenda.astro';
import IndiceLectura from '../../components/proyecto/IndiceLectura.astro';
import Columna from '../../components/proyecto/Columna.astro';
import OtrosProyectos from '../../components/proyecto/OtrosProyectos.astro';
import FichaConceptual from '../../components/visuals/FichaConceptual.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { getProyecto } from '../../data/proyectos';

const p = getProyecto('03');
---

<Layout title={`${p.titulo} — ${site.nombre}`} description={p.resumen}>
  <DetalleNav />
  <main>
    <!-- Apertura de galería -->
    <section class="container-page flex flex-col gap-10 pt-[34px]">
      <Ruta numero="03" />
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:gap-[100px]">
        <Titulo numero="03" titulo={p.titulo} subtitulo={p.subtitulo} estado={p.estado} class="flex-1" />
        <div class="flex flex-col gap-3.5 pb-2.5 lg:w-80 lg:shrink-0">
          <p class="note text-mint">PROYECTO PERSONAL / 03</p>
          <p class="body-copy text-sm">Ficha preparada para incorporar la documentación de TCGCheck.</p>
        </div>
      </div>

      <div class="grid gap-10 lg:grid-cols-[840fr_416fr]">
        <div class="flex flex-col gap-4">
          <FichaConceptual
            comentario="// proyecto_03 · TCGCheck"
            flujo="idea → desarrollo → aprendizaje"
            bajada="Una nueva historia para documentar."
            codigo={`{
  proyecto: "TCGCheck",
  ficha: "lista para completar"
}`}
          />
          <Leyenda texto="Referencia conceptual; la captura real del proyecto se incorporará aquí." />
        </div>
        <div class="flex flex-col gap-7">
          <Datos datos={p.datos} variant="tarjeta" />
          <div class="flex flex-col gap-3 px-6">
            <span class="font-mono text-[42px] leading-none text-mint" aria-hidden="true">{'{ }'}</span>
            <p class="body-copy text-sm">
              Un lugar para mostrar el proyecto con información real, sin anticipar resultados ni tecnologías.
            </p>
          </div>
        </div>
      </div>

      <IndiceLectura numero="03" omitir={['proceso']} />
    </section>

    <!-- Contexto y objetivo -->
    <section id="contexto" class="container-page grid scroll-mt-4 gap-12 pt-[72px] pb-[72px] md:grid-cols-2 md:gap-x-[100px]">
      <Columna
        etiqueta="// 01 / contexto"
        titulo="El punto de partida."
        texto="Espacio para contar de dónde nació TCGCheck, qué necesidad aborda y en qué contexto se desarrolló."
      />
      <Columna
        etiqueta="// objetivo"
        titulo="Una intención clara."
        texto="Espacio para definir el objetivo, las personas a las que se dirige y el alcance del proyecto."
      />
    </section>

    <!-- Cierre del proyecto -->
    <section class="container-page grid gap-12 pb-[72px] lg:grid-cols-[740fr_508fr] lg:gap-12">
      <div id="solucion" class="flex scroll-mt-4 flex-col rounded-xl bg-mint p-8 text-mint-ink md:p-10">
        <p class="note">02 / solución</p>
        <h2 class="mt-5 font-display text-[clamp(36px,3.4vw,48px)] leading-[1.1] font-bold tracking-[-0.03em]">
          El proyecto,<br />con sus decisiones.
        </h2>
        <p class="mt-6 text-base leading-[1.65] text-mint-muted">
          Espacio para presentar lo construido, explicar las decisiones principales y sumar evidencias del
          funcionamiento.
        </p>
      </div>
      <Columna
        id="aprendizajes"
        class="lg:mt-9"
        etiqueta="// 03 / aprendizajes"
        titulo="Lo que cambia después."
        texto="Espacio para compartir aprendizajes, dificultades y próximos pasos a partir de esta experiencia."
      />
    </section>

    <OtrosProyectos actual="03" />
  </main>
  <Footer label="← Volver al índice de proyectos" href="/portfolio#proyectos" />
</Layout>
